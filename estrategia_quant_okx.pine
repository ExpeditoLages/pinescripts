//@version=5
strategy("Estratégia Quant Cripto - OKX Futuros", shorttitle="Quant OKX", overlay=true, calc_on_every_tick=false, calc_on_order_fills=false, initial_capital=1000, default_qty_type=strategy.percent_of_equity, default_qty_value=10, commission_type=strategy.commission.percent, commission_value=0.05)

// -----------------------------------------------------------------------------
// Parâmetros da Estratégia
// -----------------------------------------------------------------------------
// EMAs (Médias Móveis Exponenciais)
emaFastLen = input.int(20, title="Período EMA Rápida", group="Tendência")
emaSlowLen = input.int(50, title="Período EMA Lenta", group="Tendência")
emaMacroLen = input.int(200, title="Período EMA Macro", group="Tendência")

// RSI (Índice de Força Relativa)
rsiLen = input.int(14, title="Período RSI", group="Momentum")
rsiOB = input.int(70, title="RSI Sobrecomprado", group="Momentum")
rsiOS = input.int(30, title="RSI Sobrevendido", group="Momentum")

// ATR (Average True Range) & Gestão de Risco
atrLen = input.int(14, title="Período ATR", group="Gestão de Risco")
slMultiplier = input.float(2.0, title="Multiplicador Stop Loss (ATR)", group="Gestão de Risco", step=0.1)
tpMultiplier = input.float(4.0, title="Multiplicador Take Profit (ATR)", group="Gestão de Risco", step=0.1)

// -----------------------------------------------------------------------------
// Indicadores
// -----------------------------------------------------------------------------
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)
emaMacro = ta.ema(close, emaMacroLen)

rsi = ta.rsi(close, rsiLen)
atr = ta.atr(atrLen)

// -----------------------------------------------------------------------------
// Lógica da Estratégia (Sem repintura: usando fechamentos confirmados)
// -----------------------------------------------------------------------------
// Condições para Compra (Long)
// 1. EMA Rápida cruza acima da EMA Lenta
// 2. Preço está acima da EMA Macro (Tendência de Alta)
// 3. RSI não está sobrecomprado
longCondition = ta.crossover(emaFast, emaSlow) and close > emaMacro and rsi < rsiOB

// Condições para Venda (Short)
// 1. EMA Rápida cruza abaixo da EMA Lenta
// 2. Preço está abaixo da EMA Macro (Tendência de Baixa)
// 3. RSI não está sobrevendido
shortCondition = ta.crossunder(emaFast, emaSlow) and close < emaMacro and rsi > rsiOS

// -----------------------------------------------------------------------------
// Execução e Gestão de Risco
// -----------------------------------------------------------------------------
var float longSL = na
var float longTP = na
var float shortSL = na
var float shortTP = na

if (longCondition and strategy.position_size == 0)
    strategy.entry("Long", strategy.long)
    longSL := close - (atr * slMultiplier)
    longTP := close + (atr * tpMultiplier)

if (shortCondition and strategy.position_size == 0)
    strategy.entry("Short", strategy.short)
    shortSL := close + (atr * slMultiplier)
    shortTP := close - (atr * tpMultiplier)

// Lógica de Saída
if (strategy.position_size > 0)
    strategy.exit("Sair Long", "Long", stop=longSL, limit=longTP)

if (strategy.position_size < 0)
    strategy.exit("Sair Short", "Short", stop=shortSL, limit=shortTP)

// -----------------------------------------------------------------------------
// Plotagem Gráfica
// -----------------------------------------------------------------------------
plot(emaFast, color=color.blue, title="EMA Rápida")
plot(emaSlow, color=color.orange, title="EMA Lenta")
plot(emaMacro, color=color.white, title="EMA Macro", linewidth=2)

// Mostrar níveis de Stop Loss e Take Profit quando estiver em uma operação
plot(strategy.position_size > 0 ? longSL : na, color=color.red, style=plot.style_linebr, linewidth=2, title="Long SL")
plot(strategy.position_size > 0 ? longTP : na, color=color.green, style=plot.style_linebr, linewidth=2, title="Long TP")

plot(strategy.position_size < 0 ? shortSL : na, color=color.red, style=plot.style_linebr, linewidth=2, title="Short SL")
plot(strategy.position_size < 0 ? shortTP : na, color=color.green, style=plot.style_linebr, linewidth=2, title="Short TP")
