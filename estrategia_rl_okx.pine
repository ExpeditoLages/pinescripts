//@version=5
strategy("Q-Learning SuperTrend Quant - OKX", shorttitle="RL Quant OKX", overlay=true, calc_on_every_tick=false, calc_on_order_fills=false, initial_capital=1000, default_qty_type=strategy.percent_of_equity, default_qty_value=10, commission_type=strategy.commission.percent, commission_value=0.05)

// -----------------------------------------------------------------------------
// Parâmetros da Estratégia e Ambiente
// -----------------------------------------------------------------------------
// Indicadores Modernos
stFactor = input.float(3.0, title="Fator SuperTrend", group="Indicadores")
stPeriod = input.int(10, title="Período SuperTrend", group="Indicadores")
adxLen = input.int(14, title="Período ADX", group="Indicadores")
chopLen = input.int(14, title="Período Choppiness", group="Indicadores")

// Parâmetros Q-Learning
useRL = input.bool(true, title="Usar Agente Q-Learning?", group="Aprendizado por Reforço")
gamma = input.float(0.9, title="Fator de Desconto (Gamma)", group="Aprendizado por Reforço", step=0.05)
lr = input.float(0.01, title="Taxa de Aprendizado (LR)", group="Aprendizado por Reforço", step=0.005)

// Gestão de Risco Básica
atrLen = input.int(14, title="Período ATR (Stop Dinâmico)", group="Risco")
slMultiplier = input.float(2.0, title="Stop Loss (ATRx)", group="Risco", step=0.1)

// -----------------------------------------------------------------------------
// Helpers de Matriz
// -----------------------------------------------------------------------------
// Multiplicação ponto a ponto (Hadamard product)
hadamard(matA, matB) =>
    rows = matrix.rows(matA)
    cols = matrix.columns(matA)
    res = matrix.new<float>(rows, cols)
    for r = 0 to rows - 1
        for c = 0 to cols - 1
            matrix.set(res, r, c, matrix.get(matA, r, c) * matrix.get(matB, r, c))
    res

// Subtração de matrizes ponto a ponto
mat_sub(matA, matB) =>
    rows = matrix.rows(matA)
    cols = matrix.columns(matA)
    res = matrix.new<float>(rows, cols)
    for r = 0 to rows - 1
        for c = 0 to cols - 1
            matrix.set(res, r, c, matrix.get(matA, r, c) - matrix.get(matB, r, c))
    res

// Adição com BroadCasting simplificado (matriz NxM + Bias 1xM)
add_bias(matA, bias_vec) =>
    rows = matrix.rows(matA)
    cols = matrix.columns(matA)
    res = matrix.new<float>(rows, cols)
    for r = 0 to rows - 1
        for c = 0 to cols - 1
            matrix.set(res, r, c, matrix.get(matA, r, c) + matrix.get(bias_vec, 0, c))
    res

// -----------------------------------------------------------------------------
// Indicadores Modernos (Estado / Features)
// -----------------------------------------------------------------------------
atr = ta.atr(atrLen)

// 1. SuperTrend (Direção e Força da Tendência)
[supertrend, stDirection] = ta.supertrend(stFactor, stPeriod)
stFeature = stDirection < 0 ? 1.0 : -1.0 // 1 se Uptrend, -1 se Downtrend
stDist = (close - supertrend) / close // Distância normalizada ao SuperTrend

// 2. ADX (Força do Movimento)
[diPlus, diMinus, adx] = ta.dmi(adxLen, adxLen)
adxFeature = adx / 100.0 // Normalizado [0, 1]

// 3. Choppiness Index (Tendência vs Lateralização)
// Fórmula básica do Choppiness
trSum = math.sum(ta.tr, chopLen)
hh = ta.highest(high, chopLen)
ll = ta.lowest(low, chopLen)
chop = 100 * math.log10(trSum / (hh - ll)) / math.log10(chopLen)
chopFeature = (chop - 38.2) / (61.8 - 38.2) // Normalizado centrado na golden ratio
chopFeature := math.max(math.min(chopFeature, 1.0), -1.0) // Clipping

// Vetor de Estado Atual (S)
// Temos 4 Features -> Dimensão do Estado = 4
S_current = matrix.new<float>(1, 4)
matrix.set(S_current, 0, 0, stFeature)
matrix.set(S_current, 0, 1, stDist)
matrix.set(S_current, 0, 2, adxFeature)
matrix.set(S_current, 0, 3, chopFeature)

// -----------------------------------------------------------------------------
// Q-Learning (Deep Q-Network Linear Simplificada)
// -----------------------------------------------------------------------------
// Aproximador de Função Linear: Q(s, a) = S * W + b
// Estado (1x4) -> Ações (1x2): Long e Short
var matrix<float> W = matrix.new<float>(4, 2, 0.01) // Pesos iniciados pequenos
var matrix<float> b = matrix.new<float>(1, 2, 0.0)

// Passo Forward (Estimar Q-Values para o estado atual)
Q_values_current = add_bias(matrix.mult(S_current, W), b)
Q_long_current = matrix.get(Q_values_current, 0, 0)
Q_short_current = matrix.get(Q_values_current, 0, 1)

// Seleção de Ação (Ação com maior Q-Value)
action_long = Q_long_current > Q_short_current
action_short = Q_short_current > Q_long_current

// -----------------------------------------------------------------------------
// Treinamento do Agente (Backpropagation Q-Learning)
// -----------------------------------------------------------------------------
// O Recompensa (Reward) é avaliada no fechamento com base na ação escolhida na barra anterior
// Retorno logarítmico da barra atual
reward_base = math.log(close / close[1])

if barstate.isconfirmed
    // Estado Anterior (S_prev)
    S_prev = matrix.new<float>(1, 4)
    matrix.set(S_prev, 0, 0, nz(stFeature[1]))
    matrix.set(S_prev, 0, 1, nz(stDist[1]))
    matrix.set(S_prev, 0, 2, nz(adxFeature[1]))
    matrix.set(S_prev, 0, 3, nz(chopFeature[1]))

    // Q-Values da Barra Anterior
    Q_values_prev = add_bias(matrix.mult(S_prev, W), b)
    q_l_prev = matrix.get(Q_values_prev, 0, 0)
    q_s_prev = matrix.get(Q_values_prev, 0, 1)

    // Ação tomada na barra anterior (Greedy)
    took_long = q_l_prev >= q_s_prev
    took_short = q_s_prev > q_l_prev

    // Reward real dependendo da ação
    float R = 0.0
    if took_long
        R := reward_base * 100.0 // Skew para scale de redes neurais
    else if took_short
        R := -reward_base * 100.0

    // Equação de Bellman para TD Target: Y = R + gamma * max(Q(S', a'))
    max_Q_next = math.max(Q_long_current, Q_short_current)
    Q_target_val = R + (gamma * max_Q_next)

    // Calculamos o erro na matriz de Q-values
    // O erro só ocorre na ação que foi escolhida. A outra ação recebe alvo = valor anterior (erro zero)
    Y_matrix = matrix.new<float>(1, 2)
    matrix.set(Y_matrix, 0, 0, took_long ? Q_target_val : q_l_prev)
    matrix.set(Y_matrix, 0, 1, took_short ? Q_target_val : q_s_prev)

    // Erro (dZ) = (Q_pred - Y_target)
    err_mat = mat_sub(Q_values_prev, Y_matrix)

    // Gradientes
    dW = matrix.mult(matrix.transpose(S_prev), err_mat)
    db = matrix.copy(err_mat)

    // Atualização dos Pesos (SGD)
    lr_W = matrix.new<float>(4, 2, lr)
    lr_b = matrix.new<float>(1, 2, lr)

    W := mat_sub(W, hadamard(dW, lr_W))
    b := mat_sub(b, hadamard(db, lr_b))

// -----------------------------------------------------------------------------
// Execução de Trade
// -----------------------------------------------------------------------------
// Condições Finais combinando ou não com ML
longCond = (not useRL and stDirection < 0) or (useRL and action_long and stDirection < 0)
shortCond = (not useRL and stDirection > 0) or (useRL and action_short and stDirection > 0)

// Apenas executa no fechamento confirmado
longCond := longCond and barstate.isconfirmed
shortCond := shortCond and barstate.isconfirmed

var float slLong = na
var float slShort = na

if (longCond and strategy.position_size == 0)
    strategy.entry("Q-Long", strategy.long)
    slLong := close - (atr * slMultiplier)

if (shortCond and strategy.position_size == 0)
    strategy.entry("Q-Short", strategy.short)
    slShort := close + (atr * slMultiplier)

// Gestão de Risco e Saída
if (strategy.position_size > 0)
    slLong := math.max(slLong, close - (atr * slMultiplier)) // Trailing genérico em Uptrend
    strategy.exit("Exit Q-Long", "Q-Long", stop=slLong)
    if shortCond // Reversão
        strategy.close("Q-Long")

if (strategy.position_size < 0)
    slShort := math.min(slShort, close + (atr * slMultiplier)) // Trailing genérico em Downtrend
    strategy.exit("Exit Q-Short", "Q-Short", stop=slShort)
    if longCond // Reversão
        strategy.close("Q-Short")

// -----------------------------------------------------------------------------
// Gráficos
// -----------------------------------------------------------------------------
plot(supertrend, color=stDirection < 0 ? color.green : color.red, style=plot.style_stepline, linewidth=2, title="SuperTrend")
